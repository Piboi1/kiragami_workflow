# Copy to .env (same folder) and fill in. .env is git-ignored.

# --- SimScale -----------------------------------------------------------
# Dashboard -> your avatar -> Account settings -> API keys (SimScale must
# enable API access on your plan; request it from SimScale support if the
# API keys section is missing).
SIMSCALE_API_KEY=
SIMSCALE_API_URL=https://api.simscale.com
# Optional. Leave empty and the pipeline creates a project called
# "Kirigami_Optimizer" on first use and remembers its ID in
# state/simscale_project.json. To use an existing project, paste the ID
# from its URL (https://www.simscale.com/workbench/?pid=<THIS>).
SIMSCALE_PROJECT_ID=

# --- Google Sheets --------------------------------------------------------
# Path to the service-account key JSON (default: credentials/service_account.json).
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=runs
